{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXT full plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "next_full_plan",
    "date",
    "tasks",
    "ideas"
  ],
  "properties": {
    "next_full_plan": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The day this plan is for (normally today)"
    },
    "tasks": {
      "type": "array",
      "maxItems": 100,
      "description": "In the order to work on them. Keys and titles must be unique.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "notes",
          "priority",
          "deadline",
          "category",
          "when",
          "day",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
            "description": "Stable ID chosen by ChatGPT; keep it the same for the same task in every plan"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ]
          },
          "when": {
            "type": "string",
            "enum": [
              "today",
              "tomorrow",
              "later"
            ]
          },
          "day": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required when \"when\" is \"later\", otherwise null"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done",
              "cancelled"
            ]
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
